# Gabarit de configuration — copiez-le vers votre fichier d'environnement local
# (jamais commité : il est ignoré par git et illisible pour l'agent grâce au hook).
# Toutes les variables sont optionnelles ; les valeurs ci-dessous sont les défauts.

# --- Mode -------------------------------------------------------------------
EXECUTION_MODE=PAPER

# --- RPC Solana (clé API dans l'URL : ne la partagez jamais) -----------------
HELIUS_RPC_URL=
CHAINSTACK_RPC_URL=

# --- Paper trading -------------------------------------------------------------
BOT_DB_PATH=data/bot.sqlite3
POSITION_SIZE_SOL=0.05      # même taille qu'en LIVE : la simulation paie les mêmes frais relatifs
AUDIT_SIZE_SOL=0.5          # taille du devis de test (impact prix / honeypot)
JITO_TIP_LAMPORTS=100000    # pourboire par transaction : 0,0001 SOL (borné 1 000 – 5 000 000)
MAX_OPEN_POSITIONS=5
DAILY_MAX_LOSS_SOL=1.0
REENTRY_COOLDOWN_H=24       # pas de rachat d'un jeton clôturé en perte
MAX_SLIPPAGE_BPS=300
SCAN_INTERVAL_S=60
MONITOR_INTERVAL_S=15       # réévaluation complète (devis Jupiter) de toutes les positions
FAST_CHECK_INTERVAL_S=5     # entre-temps : 1 requête DexScreener ; devis immédiat si un seuil approche
TRACK_INTERVAL_S=60         # collecte de prix pour le backtest
TRACK_WINDOW_H=24

# --- Sorties adaptatives (priorités : urgence > stop > copy.top > plancher/suiveur > stagnation > durée) ---
EXIT_MODE=ATR               # ATR | FIXED ; sans ATR fiable : mode conservateur fixe (STOP_LOSS_PCT, TRAILING_STOP_PCT)
ATR_PERIOD=14               # bougies GeckoTerminal 5 min
ATR_SL_MULT=2.2             # SL = -min(SL_MAX_ABS_PCT, max(SL_MIN_ABS_PCT, 2,2 x ATR%))
ATR_TRAIL_MULT=2.0          # suiveur = min(TRAIL_MAX_PCT, max(TRAIL_MIN_PCT, 2,0 x ATR%)), jamais desserré
SL_MIN_ABS_PCT=18
SL_MAX_ABS_PCT=38
TRAIL_MIN_PCT=20
TRAIL_MAX_PCT=35
ATR_ALLOW_M5_PROXY=false    # |variation 5 min| comme repli (étiqueté DEX_M5_PROXY, pas un ATR)
STOP_LOSS_PCT=-25           # stop fixe du mode conservateur
TRAILING_STOP_PCT=25        # suiveur fixe du mode conservateur
TP1_TRIGGER_PCT=40          # vente partielle à +40 % NET
TP1_FRACTION=0.30           # 30 % vendus, 70 % conservés
POST_TP1_FLOOR_PCT=3.0      # après TP1 : sortie si le PnL NET repasse sous +3 %
TAKE_PROFIT_PCT=300
STAGNATION_MIN=20           # sortie si >= 20 min sans jamais +8 % et sous +3 %
STAGNATION_MIN_PEAK_PCT=8.0
STAGNATION_CURRENT_MAX_PCT=3.0
MAX_HOLD_MINUTES=120

# --- Entrées : vélocité et politique d'âge (après les filtres de sécurité) ------------------
PAIR_AGE_POLICY=STRICT      # STRICT (défaut) | PAPER_FAST (expérimental, à activer explicitement)
MIN_PAIR_AGE_STRICT_MIN=30  # STRICT : toutes sources, + MIN_TXNS_H1
MIN_PAIR_AGE_SCAN_MIN=10    # PAPER_FAST : scan
MIN_PAIR_AGE_SIGNAL_MIN=3   # PAPER_FAST : copytop / smart
MAX_PAIR_AGE_MIN=10080
MIN_TXNS_H1=30
MIN_TXNS_M5=20
MIN_VOL_M5_USD=2500
MIN_BUY_SELL_RATIO_M5=1.15
MAX_BUY_SELL_RATIO_M5=6.5   # au-delà : activité probablement artificielle
MIN_VOL_ACCEL_M5_H1=1.3     # (volume_m5 x 12) / volume_h1
MIN_LIQ_MCAP_RATIO=0.08
MAX_LIQ_MCAP_RATIO=0.70
MIN_PRICE_CHANGE_H1=-15
MAX_PRICE_CHANGE_H1=250
SCAN_BATCH_MAX=20           # jetons audités au plus par cycle de scan

# --- Taille de position (plafond dur : 0,05 SOL par position, non contournable) -------------
SIZING_MODE=fixed           # fixed | kelly (Kelly fractionné, statistiques du SEUL moteur concerné)
KELLY_MULTIPLIER=0.25
MAX_POSITION_SOL=0.05
PAPER_BANKROLL_SOL=1.0
MIN_TRADES_FOR_SIZING=30    # après ce nombre, un avantage mesuré négatif MET EN PAUSE les entrées

# --- Risque : coupe-circuit par moteur et régime macro SOL --------------------------------
SOURCE_CB_MAX_LOSSES=25     # pause d'un moteur après 25 trades perdants (réactivation : run_bot.py reactivate-source)
MACRO_FILTER_ENABLED=true
SOL_DROP_H1_LIMIT_PCT=-5    # SOL < -5 % sur 1 h (ou donnée inconnue/périmée) => 2 positions max
RISK_MAX_ACTIVE_POSITIONS_STRESS=2

# --- Shadow Ledger (analytique : jetons rejetés pour âge/activité/vélocité uniquement) -------
SHADOW_LEDGER_ENABLED=true
SHADOW_PRICE_CHECK_MINUTES=15,60,120

# --- Validation (Walk-Forward ancré, 18 profils) -------------------------------------------
BACKTEST_WALK_FORWARD_FOLDS=4
BACKTEST_MIN_TRAIN_TRADES=30     # minimum non abaissable
BACKTEST_MIN_TRADES_TOTAL=70     # minimum non abaissable
BACKTEST_MIN_PROFIT_FACTOR=1.2
BACKTEST_PURGE_HOURS=12
BACKTEST_MAX_DRAWDOWN_BANKROLL_PCT=-30

# --- Filtres éliminatoires (ne peuvent être que DURCIS par l'environnement) ----------------
MIN_LIQUIDITY_USD=15000
MIN_LP_LOCKED_PCT=90
MAX_TOP10_PCT=25            # concentration des 10 premiers VRAIS détenteurs (comptes techniques confirmés exclus)
MAX_PRICE_IMPACT_PCT=5
MAX_ROUNDTRIP_LOSS_PCT=10
INSIDER_CHECK_ENABLED=true  # réseaux RugCheck de type trade/transfer : rejet si >= 20 wallets ou >= 5 %
INSIDER_MAX_WALLETS=20
INSIDER_MAX_HOLDING_PCT=5
CREATOR_MAX_TOKENS_7D=3     # créateur sériel (nécessite un RPC ; non validé en conditions réelles)
CREATOR_CHECK_REQUIRED=false  # true : historique créateur inconnu => rejet

# --- Signaux sociaux ---------------------------------------------------------------
SOCIAL_ENABLED=true
REQUIRE_SOCIAL_LINK=true          # exige au moins un lien X/Telegram/Discord/site déclaré
MAX_BOOSTS_ACTIVE=500             # au-delà : hype achetée sur DexScreener
# X (optionnel) : clé "Bearer Token" d'une app sur developer.x.com (recherche = accès payant)
X_BEARER_TOKEN=
MIN_X_MENTIONS_6H=5               # mentions minimales sur 6 h (si X configuré)
MIN_X_UNIQUE_AUTHORS_RATIO=0.4    # en dessous : peu de comptes qui postent beaucoup = shill

# --- Moteur 2 : Smart Money (meilleurs wallets, données publiques GeckoTerminal) ------
SMART_ENABLED=true
SMART_INTERVAL_S=60
SMART_POOLS_PER_CYCLE=3          # pools lus par cycle (quota GeckoTerminal 10/min partagé)
SMART_MIN_CLOSED_TOKENS=3        # jetons achetés puis revendus pour juger un wallet
SMART_MIN_WIN_RATE=0.35         # les meilleurs traders Pump.fun gagnent avec 23–56 % de réussite
SMART_MIN_PNL_USD=500            # PnL réalisé minimum observé
SMART_MAX_TRADES_PER_TOKEN=15    # au-delà : robot de volume / MEV, exclu
SMART_MIN_BUY_USD=100            # achat significatif
SMART_WINDOW_MIN=30              # fenêtre de détection des achats
SMART_MIN_WALLETS=2              # wallets smart distincts sur le même jeton
SMART_MAX_CHASE_PCT=50           # pas d'entrée si le prix a déjà pris +50 % depuis leur achat
# Wallets suivis d'office (ex. copiés du classement Pump.fun), séparés par des virgules
SMART_WALLETS=

# --- Signaux copy.top (classement PnL Pump.fun, gratuit, lecture seule) ----------------
COPYTOP_ENABLED=true
COPYTOP_INTERVAL_S=60
COPYTOP_MIN_TOP_TRADERS=3        # top traders ayant acheté le même jeton
COPYTOP_MIN_STILL_IN=2           # ... et toujours en position
COPYTOP_MAX_SIGNAL_AGE_MIN=30    # signal plus ancien ignoré
COPYTOP_EXIT_MIN_SELLERS=2       # sortie si au moins 2 traders de la cohorte vendent
COPYTOP_EXIT_RATIO=0.5           # ... et au moins 50 % de la cohorte
COPYTOP_EXIT_MIN_USD=100         # ventes significatives uniquement
COPYTOP_EXIT_ON_DROP_BELOW_MIN=true   # présence < COPYTOP_MIN_STILL_IN (donnée complète) : sortie si gain < 10 %
COPYTOP_MIN_POOL_AGE_MIN=5       # âge minimal du pool ; âge inconnu = rejet
COPYTOP_ONLY_CLEAN_FAIRPLAY=true # cohorte : fair play « clean » uniquement
COPYTOP_MIN_AVG_HOLD_MIN=5       # cohorte : détention moyenne >= 5 min (classement copy.top)
COPYTOP_MIN_ELIGIBLE_TRADERS=2
COPYTOP_WAIT_MIGRATION_TTL_MIN=45   # file de migration Pump.fun -> PumpSwap/Raydium/Meteora
COPYTOP_WATCHLIST_MAX_SIZE=50

# --- Analyseur LLM local (optionnel) ------------------------------------------------
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
REQUIRE_LLM=false

# --- Exécution réelle : FONDS RÉELS EN JEU --------------------------------------
# Les trois lignes suivantes doivent TOUTES être renseignées, avec EXECUTION_MODE=LIVE.
# Utilisez un wallet DÉDIÉ, approvisionné avec une somme que vous acceptez de perdre.
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_FUNDS_AT_RISK
# SOLANA_KEYPAIR_PATH=/chemin/vers/wallet-dedie.json
LIVE_MAX_POSITION_SOL=0.05
# JITO_TIP_LAMPORTS (plus haut) s'applique aussi au réel : trop bas, la transaction peut tarder.
JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions
