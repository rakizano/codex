# Gabarit de configuration — copiez-le vers votre fichier d'environnement local
# (jamais commité : il est ignoré par git et illisible pour l'agent grâce au hook).
# Toutes les variables sont optionnelles ; les valeurs ci-dessous sont les défauts.

# --- Mode -------------------------------------------------------------------
EXECUTION_MODE=PAPER

# --- RPC Solana (clé API dans l'URL : ne la partagez jamais) -----------------
HELIUS_RPC_URL=
CHAINSTACK_RPC_URL=

# --- Paper trading -------------------------------------------------------------
BOT_DB_PATH=data/bot.sqlite3
POSITION_SIZE_SOL=0.05      # même taille qu'en LIVE : la simulation paie les mêmes frais relatifs
AUDIT_SIZE_SOL=0.5          # taille du devis de test (impact prix / honeypot)
JITO_TIP_LAMPORTS=100000    # pourboire par transaction : 0,0001 SOL (borné 1 000 – 5 000 000)
MAX_OPEN_POSITIONS=5
DAILY_MAX_LOSS_SOL=1.0
REENTRY_COOLDOWN_H=24       # pas de rachat d'un jeton clôturé en perte
MAX_SLIPPAGE_BPS=300
SCAN_INTERVAL_S=60
MONITOR_INTERVAL_S=15       # réévaluation complète (devis Jupiter) de toutes les positions
FAST_CHECK_INTERVAL_S=5     # entre-temps : 1 requête DexScreener ; devis immédiat si un seuil approche
TRACK_INTERVAL_S=60         # collecte de prix pour le backtest
TRACK_WINDOW_H=24

# --- Sorties (remplacez par les valeurs de `run_bot.py optimize` quand il en propose) ---
STOP_LOSS_PCT=-25
TP1_PCT=40                  # vente partielle ("off" pour désactiver)
TP1_FRACTION=0.5
BREAKEVEN_AFTER_TP1=true    # après TP1, le stop remonte au prix d'entrée
TRAIL_ACTIVATION_PCT=40     # stop suiveur actif à partir de ce gain ("off" pour désactiver)
TRAILING_STOP_PCT=25        # sortie si recul de 25 % depuis le plus haut
TAKE_PROFIT_PCT=300         # sortie totale
MAX_HOLD_MINUTES=240

# --- Entrées « momentum » (après les filtres de sécurité) --------------------------
MIN_PAIR_AGE_MIN=30         # évite la zone des snipers/bundlers
MAX_PAIR_AGE_MIN=10080
MIN_PRICE_CHANGE_H1=-20     # évite les jetons en chute
MAX_PRICE_CHANGE_H1=300     # évite d'acheter le sommet d'un mouvement parabolique ("off" possible)
MIN_BUY_SELL_RATIO_H1=1.0
MIN_TXNS_H1=30
MIN_VOLUME_LIQUIDITY_H1=0

# --- Taille de position ------------------------------------------------------------------
SIZING_MODE=fixed           # fixed | kelly (Kelly fractionné après MIN_TRADES_FOR_SIZING trades)
KELLY_MULTIPLIER=0.25
MAX_POSITION_SOL=0.2
PAPER_BANKROLL_SOL=1.0
MIN_TRADES_FOR_SIZING=30    # après ce nombre, un avantage mesuré négatif MET EN PAUSE les entrées

# --- Filtres éliminatoires -----------------------------------------------------
MIN_LIQUIDITY_USD=15000
MIN_LP_LOCKED_PCT=90
MAX_TOP10_PCT=25
MAX_PRICE_IMPACT_PCT=5
MAX_ROUNDTRIP_LOSS_PCT=10

# --- Signaux sociaux ---------------------------------------------------------------
SOCIAL_ENABLED=true
REQUIRE_SOCIAL_LINK=true          # exige au moins un lien X/Telegram/Discord/site déclaré
MAX_BOOSTS_ACTIVE=500             # au-delà : hype achetée sur DexScreener
# X (optionnel) : clé "Bearer Token" d'une app sur developer.x.com (recherche = accès payant)
X_BEARER_TOKEN=
MIN_X_MENTIONS_6H=5               # mentions minimales sur 6 h (si X configuré)
MIN_X_UNIQUE_AUTHORS_RATIO=0.4    # en dessous : peu de comptes qui postent beaucoup = shill

# --- Moteur 2 : Smart Money (meilleurs wallets, données publiques GeckoTerminal) ------
SMART_ENABLED=true
SMART_INTERVAL_S=60
SMART_POOLS_PER_CYCLE=3          # pools lus par cycle (quota GeckoTerminal 10/min partagé)
SMART_MIN_CLOSED_TOKENS=3        # jetons achetés puis revendus pour juger un wallet
SMART_MIN_WIN_RATE=0.35         # les meilleurs traders Pump.fun gagnent avec 23–56 % de réussite
SMART_MIN_PNL_USD=500            # PnL réalisé minimum observé
SMART_MAX_TRADES_PER_TOKEN=15    # au-delà : robot de volume / MEV, exclu
SMART_MIN_BUY_USD=100            # achat significatif
SMART_WINDOW_MIN=30              # fenêtre de détection des achats
SMART_MIN_WALLETS=2              # wallets smart distincts sur le même jeton
SMART_MAX_CHASE_PCT=50           # pas d'entrée si le prix a déjà pris +50 % depuis leur achat
# Wallets suivis d'office (ex. copiés du classement Pump.fun), séparés par des virgules
SMART_WALLETS=

# --- Signaux copy.top (classement PnL Pump.fun, gratuit, lecture seule) ----------------
COPYTOP_ENABLED=true
COPYTOP_INTERVAL_S=60
COPYTOP_MIN_TOP_TRADERS=3        # top traders ayant acheté le même jeton
COPYTOP_MIN_STILL_IN=2           # ... et toujours en position
COPYTOP_MAX_SIGNAL_AGE_MIN=30    # signal plus ancien ignoré
COPYTOP_EXIT_MIN_SELLERS=2       # sortie si au moins 2 acheteurs initiaux revendent
COPYTOP_EXIT_RATIO=0.5           # ... et si cela représente au moins 50 % du groupe suivi

# --- Analyseur LLM local (optionnel) ------------------------------------------------
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
REQUIRE_LLM=false

# --- Exécution réelle : FONDS RÉELS EN JEU --------------------------------------
# Les trois lignes suivantes doivent TOUTES être renseignées, avec EXECUTION_MODE=LIVE.
# Utilisez un wallet DÉDIÉ, approvisionné avec une somme que vous acceptez de perdre.
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_FUNDS_AT_RISK
# SOLANA_KEYPAIR_PATH=/chemin/vers/wallet-dedie.json
LIVE_MAX_POSITION_SOL=0.05
# JITO_TIP_LAMPORTS (plus haut) s'applique aussi au réel : trop bas, la transaction peut tarder.
JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions
