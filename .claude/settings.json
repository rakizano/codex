{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*id.json)",
      "Read(**/*keypair*.json)",
      "Bash(solana transfer:*)",
      "Bash(spl-token transfer:*)",
      "Bash(solana-keygen:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|Grep|Glob|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-trading.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
